cabal-version: 2.4
name: hs2json
version: 0.1.0.0
build-type: Simple
synopsis: Projeto de representacao e formatacao JSON em Haskell
category: Text

library
    hs-source-dirs: src
    exposed-modules:
        SimpleJSON
        Prettify
        PrettyJSON
    build-depends:
        base >= 4.14 && < 5
    default-language: Haskell2010

executable hs2json-demo
    main-is: TesteManual.hs
    hs-source-dirs: test
    build-depends:
        base >= 4.14 && < 5,
        hs2json
    default-language: Haskell2010
